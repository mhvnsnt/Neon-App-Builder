# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_AI_STUDIO_API_KEY=""

# OPENAI_API_KEY: Required for OpenAI GPT models
OPENAI_API_KEY=""

# DEEPSEEK_API_KEY: Required for DeepSeek models
DEEPSEEK_API_KEY=""

# GROQ_API_KEY: Required for Groq models (Llama 3.3)
GROQ_API_KEY=""

# PINECONE_API_KEY: Required for Long-Term Vector Memory
PINECONE_API_KEY=""

# SUPABASE_URL / SUPABASE_ANON_KEY: Required for external full database persistence
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_AUTH_TOKEN: REQUIRED. Shared secret for the /api endpoints.
# Every request must send `Authorization: Bearer <APP_AUTH_TOKEN>`; the web UI asks for it once
# and stores it in the browser. If unset, the API refuses to run (HTTP 503, fail closed).
# Generate one with: openssl rand -hex 32
APP_AUTH_TOKEN=""

# ENABLE_SHELL_TOOL: Optional. Set to "1" to let the agent run shell commands
# (execute_command / execute_background_command). Off by default; only enable on your own machine.
ENABLE_SHELL_TOOL=""
